    {
      "id": "4da802d8-7601-4381-9d9c-cbe67d108a61",
      "cell_type": "markdown",
      "source": "## Visualzation (Histogram)",
      "metadata": {}
    },
    {
      "id": "157f6044-0054-4e14-b795-5389ac161ca9",
      "cell_type": "code",
      "source": "ggplot(df, aes(x = gnipc)) +                # Refer to data in \"df\", define X-Axis by variable \"grp\"\n  geom_histogram(bins = 10,               # Number of bars/classes. \n                 fill = \"steelblue\",      # Bar fill color \n                 color = \"white\",         # Bar border color\n                 alpha = 0.8) +           # Transparency (0-1)\n  labs(title = \"Distribution of Gross Regional Product per capita across Chinese Provinces 2024\",# Chart title\n       subtitle = \"In 10,000 CNY\",        # Chart subtitle\n       x = \"Gross Regional Product\",                   # X-Axix label \n       y = \"Count\",                       # Y-Axix label  \n       caption = \"Data Source: National Bureau of Statistics of China\") +  # Chart caption\n  theme_minimal()                         # Chart general layout",
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "execution_count": 9
    },
    {
      "id": "a1c7db0f-13fe-496e-bc3c-16effad3a5e9",
